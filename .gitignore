__pycache__/
*.pyc
.venv/

# pywayland.scanner output -- a build artifact, regenerated by install.sh.
# NOTE: comments must be on their OWN line. Git does not treat "#" as an inline
# comment, so "var/    # runtime state" is a literal pattern that matches
# nothing -- which is exactly what four of these rules used to do.
src/hivemind/platform/wl/gen/

# machine-specific calibration
data/calib/*.local.yaml

# runtime state, telemetry, recordings
var/
*.hmr

# generated by install.sh with absolute paths baked in
/Hivemind.desktop

# the Windows installer's output and download cache (installer/build.ps1)
installer/build/
installer/cache/

# the Linux test package (installer/linux/build.sh)
dist/
